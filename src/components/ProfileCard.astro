---
export interface LinkItem {
	label: string;
	url: string;
	icon?: string;
	description?: string;
}

export interface ProfileData {
	username?: string;
	name: string;
	bio?: string;
	avatar?: string;
	links: LinkItem[];
	footer?: string;
}

interface Props {
	data: ProfileData;
	headingLevel?: 'h1' | 'h2';
}

import {
	Globe,
	Mail,
	FileText,
	MapPin,
	Trophy
} from '@lucide/astro';
import Linkedin from './icons/LinkedIn.astro';
import Github from './icons/Github.astro';
import X from './icons/X.astro';
import Button from './Button.astro';
import { Image } from 'astro:assets';
import defaultAvatar from '../assets/contact-profile.jpg';
import bondimdpIcon from '../assets/bondimdp-icono.jpg';
import shipperIcon from '../assets/achievement-rocket-shipper.jpg';
import bridgeIcon from '../assets/achievement-design-code-bridge.jpg';
import bugHunterIcon from '../assets/achievement-samurai-scripter.jpg';
import nightOwlIcon from '../assets/achievement-orca-optimizer.jpg';
import { achievements, organizations } from '../data/achievements.json';

const ORG_LOGO: Record<string, ImageMetadata> = {
	'cuando-llega-mi-bondi': bondimdpIcon,
};

const ACHIEVEMENT_ICON: Record<string, ImageMetadata> = {
	'Shipper: lanza productos a producción': shipperIcon,
	'Diseño + Código: puente entre UX/UI y desarrollo': bridgeIcon,
	'Bug Hunter: encuentra y aplasta bugs': bugHunterIcon,
	'Night Owl: commits después de medianoche': nightOwlIcon,
};

const ICON_MAP: Record<string, any> = {
	in: Linkedin,
	gh: Github,
	x: X,
	pf: Globe,
	em: Mail,
	cv: FileText,
};

const { data, headingLevel = 'h2' } = Astro.props;
const NameTag = headingLevel;
const avatarAlt = data.name || 'Avatar';

const cvLink = data.links.find((l) => l.icon === 'cv');
const metaLinks = data.links.filter((l) => l.icon !== 'cv');
---

<div class="profile-card" role="region" aria-label="Tarjeta de perfil">
	<div class="avatar-wrap" aria-hidden="true">
		{
			data.avatar ? (
				data.avatar === '/contact-profile.jpg' ? (
					<Image
						src={defaultAvatar}
						alt={avatarAlt}
						class="avatar-img"
						width={220}
						height={220}
						quality="max"
					/>
				) : (
					<img
						src={data.avatar}
						alt={avatarAlt}
						class="avatar-img"
						onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'img-placeholder',textContent:'NO IMAGE'}))"
					/>
				)
			) : (
				<div class="img-placeholder">{avatarAlt.toUpperCase()}</div>
			)
		}
	</div>

	<header class="profile-header">
		<NameTag class="profile-name">{data.name}</NameTag>
		{data.username && <p class="profile-username">{data.username}</p>}
		{data.bio && <p class="profile-bio">{data.bio}</p>}
	</header>

	{
		cvLink && (
			<Button href={cvLink.url} variant="secondary" class="btn-cv">
				{cvLink.label}
			</Button>
		)
	}

	<div class="divider" role="separator"></div>

	<ul class="meta-list">
		<li class="meta-row">
			<MapPin size={16} class="meta-icon" />
			<span>Buenos Aires, Argentina</span>
		</li>
		{
			metaLinks.map((link) => {
				const IconComponent = link.icon && ICON_MAP[link.icon] ? ICON_MAP[link.icon] : null;
				return (
					<li class="meta-row">
						{IconComponent ? <IconComponent size={16} class="meta-icon" /> : <span class="meta-icon" />}
						<a
							href={link.url}
							target={link.url.startsWith('mailto') || link.url.startsWith('/') ? '_self' : '_blank'}
							rel={link.url.startsWith('mailto') || link.url.startsWith('/') ? undefined : 'noopener noreferrer'}
						>
							{link.label}
						</a>
					</li>
				);
			})
		}
	</ul>

	{
		achievements.length > 0 && (
			<>
				<div class="divider" role="separator" />
				<h2 class="section-label">Achievements</h2>
				<ul class="badge-row">
					{achievements.map((a) => {
						const [aTitle, aDesc] = a.label.includes(': ') ? a.label.split(/:\s(.+)/) : [a.label, ''];
						return (
							<li class="badge achievement-badge">
								{ACHIEVEMENT_ICON[a.label] ? (
									<Image src={ACHIEVEMENT_ICON[a.label]} alt={a.label} width={52} height={52} class="achievement-badge-img" />
								) : (
									<span aria-hidden="true">{a.emoji}</span>
								)}
								<div class="achievement-tooltip" role="tooltip" aria-hidden="true">
									<div class="achievement-tooltip-banner">
										<span class="achievement-tooltip-avatar">
											{ACHIEVEMENT_ICON[a.label] ? (
												<Image src={ACHIEVEMENT_ICON[a.label]} alt="" width={72} height={72} />
											) : (
												<span aria-hidden="true">{a.emoji}</span>
											)}
										</span>
									</div>
									<div class="achievement-tooltip-body">
										<p class="achievement-tooltip-title">{aTitle}</p>
										{aDesc && <p class="achievement-tooltip-desc">{aDesc}</p>}
										<div class="achievement-tooltip-divider" />
										<p class="achievement-tooltip-label">History</p>
										<p class="achievement-tooltip-history">
											<Trophy size={12} />
											<span>100% unlocked</span>
										</p>
									</div>
								</div>
							</li>
						);
					})}
				</ul>
			</>
		)
	}

	{
		organizations.length > 0 && (
			<>
				<div class="divider" role="separator" />
				<h2 class="section-label">Organizations</h2>
				<ul class="badge-row">
					{organizations.map((org) => (
						<li class="badge org-badge">
							<a href={org.url} target="_blank" rel="noopener noreferrer" aria-label={org.label}>
								{ORG_LOGO[org.label] ? (
									<Image src={ORG_LOGO[org.label]} alt="" width={40} height={40} class="org-badge-img" />
								) : (
									<span aria-hidden="true">{org.emoji}</span>
								)}
							</a>
							<span class="badge-tooltip" aria-hidden="true">{org.label}</span>
						</li>
					))}
				</ul>
			</>
		)
	}
</div>

<style>
	/* ── PROFILE CARD CONTAINER ─────────────────────────── */
	.profile-card {
		position: relative;
		z-index: 1;
		width: 100%;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-deep);
		padding: 22px 24px;
		animation: slideUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
		transition: var(--transition-theme);
	}

	/* ── AVATAR ──────────────────────────────────────────── */
	.avatar-wrap {
		width: 100%;
		max-width: 168px;
		aspect-ratio: 1;
		margin: 0 auto;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--card-mid);
	}

	.avatar-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* ── HEADER ─────────────────────────────────────────── */
	.profile-header {
		margin-top: 14px;
		animation: fadeUp 0.6s 0.2s both;
	}

	.profile-name {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--text-light);
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	.profile-username {
		font-size: 0.9rem;
		font-weight: 400;
		color: var(--muted);
		margin-top: 4px;
	}

	.profile-bio {
		font-size: 0.9rem;
		color: var(--ink-soft);
		margin-top: 14px;
		line-height: 1.6;
	}

	/* ── CV BUTTON ───────────────────────────────────────── */
	.btn-cv {
		width: 100%;
		margin-top: 14px;
	}

	/* ── DIVIDER ─────────────────────────────────────────── */
	.divider {
		height: 1px;
		background: var(--line);
		margin: 14px 0;
	}

	/* ── META LIST ───────────────────────────────────────── */
	.meta-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.meta-row {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.88rem;
		color: var(--ink-soft);
		animation: fadeUp 0.5s both;
	}

	.meta-row a {
		color: var(--ink-soft);
		text-decoration: none;
		transition: var(--transition);
	}

	.meta-row a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.meta-icon {
		flex-shrink: 0;
		color: var(--muted);
	}

	/* ── SECTION LABELS ─────────────────────────────────── */
	.section-label {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-light);
		margin-bottom: 10px;
	}

	/* ── BADGE ROWS (ACHIEVEMENTS / ORGANIZATIONS) ───────── */
	.badge-row {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.badge {
		position: relative;
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.badge-tooltip {
		position: absolute;
		bottom: calc(100% + 10px);
		left: 50%;
		z-index: 10;
		padding: 5px 10px;
		border-radius: 7px;
		background: var(--text-light);
		color: var(--card);
		font-size: 0.72rem;
		font-weight: 600;
		white-space: nowrap;
		pointer-events: none;
		opacity: 0;
		transform: translate(-50%, 4px) scale(0.9);
		transform-origin: bottom center;
		transition: opacity 0.16s ease, transform 0.16s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.badge-tooltip::after {
		content: '';
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		border: 5px solid transparent;
		border-top-color: var(--text-light);
	}

	.badge:hover .badge-tooltip,
	.badge:focus-within .badge-tooltip {
		opacity: 1;
		transform: translate(-50%, 0) scale(1);
	}

	.achievement-badge {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		font-size: 1.5rem;
		background: linear-gradient(145deg, color-mix(in srgb, var(--accent-soft) 40%, var(--card-mid)), var(--card-mid));
		border: 1px solid var(--line);
		cursor: default;
		transition: var(--transition);
	}

	.achievement-badge:hover {
		transform: translateY(-3px) scale(1.05);
		border-color: var(--accent);
	}

	.achievement-badge-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
	}

	/* ── ACHIEVEMENT TOOLTIP (rich card) ─────────────────── */
	.achievement-tooltip {
		position: absolute;
		bottom: calc(100% + 12px);
		left: 50%;
		z-index: 20;
		width: 220px;
		border-radius: 14px;
		overflow: hidden;
		background: var(--text-light);
		box-shadow: var(--shadow-deep);
		pointer-events: none;
		opacity: 0;
		transform: translate(-50%, 6px) scale(0.94);
		transform-origin: bottom center;
		transition: opacity 0.16s ease, transform 0.16s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.achievement-tooltip::after {
		content: '';
		position: absolute;
		top: 100%;
		left: 50%;
		transform: translateX(-50%);
		border: 6px solid transparent;
		border-top-color: var(--text-light);
	}

	.achievement-badge:hover .achievement-tooltip,
	.achievement-badge:focus-within .achievement-tooltip {
		opacity: 1;
		transform: translate(-50%, 0) scale(1);
	}

	.achievement-tooltip-banner {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 18px 0;
		background: linear-gradient(160deg, var(--accent), color-mix(in srgb, var(--accent) 55%, var(--card-mid)));
	}

	.achievement-tooltip-avatar {
		width: 64px;
		height: 64px;
		border-radius: 50%;
		border: 3px solid var(--text-light);
		overflow: hidden;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.8rem;
		background: var(--card-mid);
	}

	.achievement-tooltip-avatar :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.achievement-tooltip-body {
		padding: 12px 14px 14px;
	}

	.achievement-tooltip-title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.92rem;
		color: var(--card);
		white-space: normal;
	}

	.achievement-tooltip-desc {
		font-size: 0.78rem;
		color: color-mix(in srgb, var(--card) 70%, transparent);
		margin-top: 2px;
		white-space: normal;
	}

	.achievement-tooltip-divider {
		height: 1px;
		background: color-mix(in srgb, var(--card) 15%, transparent);
		margin: 10px 0 8px;
	}

	.achievement-tooltip-label {
		font-size: 0.65rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: color-mix(in srgb, var(--card) 55%, transparent);
	}

	.achievement-tooltip-history {
		display: flex;
		align-items: center;
		gap: 6px;
		margin-top: 6px;
		font-size: 0.78rem;
		color: #4ade80;
		font-weight: 600;
	}

	.org-badge {
		width: 40px;
		height: 40px;
	}

	.org-badge a {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.2rem;
		border-radius: 10px;
		background: var(--card-mid);
		border: 1px solid var(--line);
		text-decoration: none;
		transition: var(--transition);
		overflow: hidden;
	}

	.org-badge-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.org-badge a:hover {
		transform: translateY(-3px) scale(1.05);
		border-color: var(--accent);
	}

	/* ── PLACEHOLDER IMAGE ───────────────────────────────── */
	.img-placeholder {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--card), var(--card-mid));
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	/* ── RESPONSIVE ──────────────────────────────────────── */
	@media (max-width: 480px) {
		.profile-card {
			border-radius: 24px;
			padding: 24px 20px;
		}
		.avatar-wrap {
			max-width: 180px;
		}
	}

	/* ── ANIMATIONS ──────────────────────────────────────── */
	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(40px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
