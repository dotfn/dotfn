---
export interface LinkItem {
	label: string;
	url: string;
	icon?: string;
	description?: string;
}

export interface ProfileData {
	username?: string;
	name: string;
	bio?: string;
	avatar?: string;
	links: LinkItem[];
	footer?: string;
}

interface Props {
	data: ProfileData;
}

import {
	Globe,
	Mail,
	FileText,
	MapPin
} from '@lucide/astro';
import Linkedin from './icons/LinkedIn.astro';
import Github from './icons/Github.astro';
import X from './icons/X.astro';
import Button from './Button.astro';
import { Image } from 'astro:assets';
import defaultAvatar from '../assets/contact-profile.jpg';
import bondimdpIcon from '../assets/bondimdp-icono.jpg';
import { achievements, organizations } from '../data/achievements.json';

const ORG_LOGO: Record<string, ImageMetadata> = {
	'cuando-llega-mi-bondi': bondimdpIcon,
};

const ICON_MAP: Record<string, any> = {
	in: Linkedin,
	gh: Github,
	x: X,
	pf: Globe,
	em: Mail,
	cv: FileText,
};

const { data } = Astro.props;
const avatarAlt = data.name || 'Avatar';

const cvLink = data.links.find((l) => l.icon === 'cv');
const metaLinks = data.links.filter((l) => l.icon !== 'cv');
---

<div class="profile-card" role="region" aria-label="Tarjeta de perfil">
	<div class="avatar-wrap" aria-hidden="true">
		{
			data.avatar ? (
				data.avatar === '/contact-profile.jpg' ? (
					<Image
						src={defaultAvatar}
						alt={avatarAlt}
						class="avatar-img"
						width={220}
						height={220}
						quality="max"
					/>
				) : (
					<img
						src={data.avatar}
						alt={avatarAlt}
						class="avatar-img"
						onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'img-placeholder',textContent:'NO IMAGE'}))"
					/>
				)
			) : (
				<div class="img-placeholder">{avatarAlt.toUpperCase()}</div>
			)
		}
	</div>

	<header class="profile-header">
		<h1 class="profile-name">{data.name}</h1>
		{data.username && <p class="profile-username">{data.username}</p>}
		{data.bio && <p class="profile-bio">{data.bio}</p>}
	</header>

	{
		cvLink && (
			<Button href={cvLink.url} variant="secondary" class="btn-cv">
				{cvLink.label}
			</Button>
		)
	}

	<div class="divider" role="separator"></div>

	<ul class="meta-list">
		<li class="meta-row">
			<MapPin size={16} class="meta-icon" />
			<span>Buenos Aires, Argentina</span>
		</li>
		{
			metaLinks.map((link) => {
				const IconComponent = link.icon && ICON_MAP[link.icon] ? ICON_MAP[link.icon] : null;
				return (
					<li class="meta-row">
						{IconComponent ? <IconComponent size={16} class="meta-icon" /> : <span class="meta-icon" />}
						<a
							href={link.url}
							target={link.url.startsWith('mailto') || link.url.startsWith('/') ? '_self' : '_blank'}
							rel={link.url.startsWith('mailto') || link.url.startsWith('/') ? undefined : 'noopener noreferrer'}
						>
							{link.label}
						</a>
					</li>
				);
			})
		}
	</ul>

	{
		achievements.length > 0 && (
			<>
				<div class="divider" role="separator" />
				<h2 class="section-label">Achievements</h2>
				<ul class="badge-row">
					{achievements.map((a) => (
						<li class="badge achievement-badge" title={a.label}>
							<span aria-hidden="true">{a.emoji}</span>
						</li>
					))}
				</ul>
			</>
		)
	}

	{
		organizations.length > 0 && (
			<>
				<div class="divider" role="separator" />
				<h2 class="section-label">Organizations</h2>
				<ul class="badge-row">
					{organizations.map((org) => (
						<li class="badge org-badge">
							<a href={org.url} target="_blank" rel="noopener noreferrer" title={org.label}>
								{ORG_LOGO[org.label] ? (
									<Image src={ORG_LOGO[org.label]} alt={org.label} width={40} height={40} class="org-badge-img" />
								) : (
									<span aria-hidden="true">{org.emoji}</span>
								)}
							</a>
						</li>
					))}
				</ul>
			</>
		)
	}
</div>

<style>
	/* ── PROFILE CARD CONTAINER ─────────────────────────── */
	.profile-card {
		position: relative;
		z-index: 1;
		width: 100%;
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: var(--radius-card);
		box-shadow: var(--shadow-deep);
		padding: 22px 24px;
		animation: slideUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
		transition: var(--transition-theme);
	}

	/* ── AVATAR ──────────────────────────────────────────── */
	.avatar-wrap {
		width: 100%;
		max-width: 168px;
		aspect-ratio: 1;
		margin: 0 auto;
		border-radius: 50%;
		overflow: hidden;
		border: 1px solid var(--line);
		background: var(--card-mid);
	}

	.avatar-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* ── HEADER ─────────────────────────────────────────── */
	.profile-header {
		margin-top: 14px;
		animation: fadeUp 0.6s 0.2s both;
	}

	.profile-name {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--text-light);
		letter-spacing: -0.02em;
		line-height: 1.1;
	}

	.profile-username {
		font-size: 0.9rem;
		font-weight: 400;
		color: var(--muted);
		margin-top: 4px;
	}

	.profile-bio {
		font-size: 0.9rem;
		color: var(--ink-soft);
		margin-top: 14px;
		line-height: 1.6;
	}

	/* ── CV BUTTON ───────────────────────────────────────── */
	.btn-cv {
		width: 100%;
		margin-top: 14px;
	}

	/* ── DIVIDER ─────────────────────────────────────────── */
	.divider {
		height: 1px;
		background: var(--line);
		margin: 14px 0;
	}

	/* ── META LIST ───────────────────────────────────────── */
	.meta-list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.meta-row {
		display: flex;
		align-items: center;
		gap: 10px;
		font-size: 0.88rem;
		color: var(--ink-soft);
		animation: fadeUp 0.5s both;
	}

	.meta-row a {
		color: var(--ink-soft);
		text-decoration: none;
		transition: var(--transition);
	}

	.meta-row a:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	.meta-icon {
		flex-shrink: 0;
		color: var(--muted);
	}

	/* ── SECTION LABELS ─────────────────────────────────── */
	.section-label {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--text-light);
		margin-bottom: 10px;
	}

	/* ── BADGE ROWS (ACHIEVEMENTS / ORGANIZATIONS) ───────── */
	.badge-row {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.badge {
		flex-shrink: 0;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.achievement-badge {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		font-size: 1.5rem;
		background: linear-gradient(145deg, color-mix(in srgb, var(--accent-soft) 40%, var(--card-mid)), var(--card-mid));
		border: 1px solid var(--line);
		cursor: default;
		transition: var(--transition);
	}

	.achievement-badge:hover {
		transform: translateY(-3px) scale(1.05);
		border-color: var(--accent);
	}

	.org-badge {
		width: 40px;
		height: 40px;
	}

	.org-badge a {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 1.2rem;
		border-radius: 10px;
		background: var(--card-mid);
		border: 1px solid var(--line);
		text-decoration: none;
		transition: var(--transition);
		overflow: hidden;
	}

	.org-badge-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.org-badge a:hover {
		transform: translateY(-3px) scale(1.05);
		border-color: var(--accent);
	}

	/* ── PLACEHOLDER IMAGE ───────────────────────────────── */
	.img-placeholder {
		width: 100%;
		height: 100%;
		background: linear-gradient(135deg, var(--card), var(--card-mid));
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--muted);
		font-family: var(--font-display);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.1em;
	}

	/* ── RESPONSIVE ──────────────────────────────────────── */
	@media (max-width: 480px) {
		.profile-card {
			border-radius: 24px;
			padding: 24px 20px;
		}
		.avatar-wrap {
			max-width: 180px;
		}
	}

	/* ── ANIMATIONS ──────────────────────────────────────── */
	@keyframes slideUp {
		from {
			opacity: 0;
			transform: translateY(40px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
