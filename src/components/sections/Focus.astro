---
import {
	RotateCw,
	Sparkle,
	PenTool,
	Code,
	Layers,
	Search,
	MapPin,
	Smartphone,
	RefreshCw,
	Brain,
	Lightbulb,
	Terminal,
	Wrench,
} from '@lucide/astro';
import codingIcon from '../../assets/iconografia/Under-construction.svg?raw';
import productLaunchIcon from '../../assets/iconografia/Launch.svg?raw';
import aiIcon from '../../assets/iconografia/Magic offer.svg?raw';
import orderDeliveredIcon from '../../assets/iconografia/Idea.svg?raw';

// This is dark-outline-on-light-fill artwork: the outline only reads as
// "linework" because it's darker than everything around it. Flipping the
// outline to white for dark mode seemed like the adaptive move, but it made
// the outline the same brightness as the fills and the page — everything
// blends into one glow instead of showing shapes. That kind of illustration
// can't cleanly invert without being redrawn, so colors stay native/fixed —
// only the mid-tone shapes (baked into the SVGs as var(--accent)) tie into
// the current accent for a light branding touch. The card around the art
// (background, title, text) still adapts; the illustration itself sits on
// its own fixed light canvas (see .power-illustration below) so it always
// renders on the surface it was drawn for, regardless of site theme.

// icons live in a parallel array, not on `powers` itself — `powers` is a
// named export (used elsewhere to build structured data), and Astro's
// compiler doesn't hoist the raw-SVG import chain correctly when it's
// embedded inside an exported object literal.
const powerIcons = [codingIcon, productLaunchIcon, aiIcon, orderDeliveredIcon];

export const powers = [
	{
		frontTitle: 'Puente entre diseño y código',
		role: 'Full Stack Developer',
		backTitle: 'Menos idas y vueltas, más velocidad',
		backDesc: 'Diseño y desarrollo salen de la misma cabeza: sin handoff, sin fricción entre equipos.',
		bullets: [
			{ icon: PenTool, text: 'Diseño y prototipo en Figma antes de escribir código' },
			{ icon: Code, text: 'Programo el frontend completo: React, Next.js, Astro' },
			{ icon: Layers, text: 'Cero handoff: la misma persona diseña y construye' },
		],
		stats: ['PWA en producción', 'React · Next.js · Astro'],
	},
	{
		frontTitle: 'Constructor de productos reales',
		role: 'Product Thinking',
		backTitle: 'BondiMDP, de la idea a producción',
		backDesc: 'Una PWA de transporte que la comunidad adoptó sola, hoy en charlas para ser la app oficial.',
		bullets: [
			{ icon: Search, text: 'Research y validación con usuarios reales de Mar del Plata' },
			{ icon: MapPin, text: 'Arribos y recorridos en tiempo real vía geolocalización' },
			{ icon: Smartphone, text: 'Adopción orgánica, cero gasto en marketing' },
		],
		stats: ['+19k usuarios únicos', '+87k sesiones'],
	},
	{
		frontTitle: 'Velocidad sin perder calidad',
		role: 'IA & Tooling',
		backTitle: 'Si lo hago dos veces, lo automatizo',
		backDesc: 'Uso IA para acortar tiempos de entrega, pero la decisión final de cada línea sigue siendo mía.',
		bullets: [
			{ icon: Sparkle, text: 'Uso Claude y agentes para prototipar y escribir código más rápido' },
			{ icon: RefreshCw, text: 'Automatizo tareas repetitivas con scripts y APIs propias' },
			{ icon: Brain, text: 'Reviso y decido yo cada línea antes de shippear' },
		],
		stats: ['Entregas más rápidas', 'Calidad revisada por mí'],
	},
	{
		frontTitle: 'Shipper de proyectos propios',
		role: 'Indie Maker',
		backTitle: 'Si digo que lo entrego, lo entrego',
		backDesc: 'Diseño, programo y mantengo mis propios productos en producción, con la misma disciplina que le pongo al tuyo.',
		bullets: [
			{ icon: Lightbulb, text: 'lumus-control: lámparas WiZ por UDP con Tauri, sin nube (Mac/Win/Linux)' },
			{ icon: Terminal, text: 'brewmenu: monitorea Homebrew desde la barra de menú' },
			{ icon: Wrench, text: 'Los diseño, programo y mantengo yo, solo' },
		],
		stats: ['lumus-control', 'brewmenu'],
	},
];
---

<section class="home-section">
	<h2 class="section-num">02 / Cómo Trabajo</h2>
	<h3 class="section-heading">Lo que sumo a tu producto</h3>

	<div class="powers-grid">
		{
			powers.map((power, i) => (
				<button type="button" class="power-card" aria-pressed="false" aria-label={`${power.frontTitle}, tocá para ver más`}>
					<div class="power-card-inner">
						<div class="power-face power-front">
							<Sparkle size={14} class="power-sparkle power-sparkle-a" />
							<Sparkle size={10} class="power-sparkle power-sparkle-b" />
							<h4>{power.frontTitle}</h4>
							<div class="power-illustration">
								<div class="power-icon" set:html={powerIcons[i]} />
							</div>
							<span class="power-hint">
								<RotateCw size={12} />
								Tocá para ver más
							</span>
							<span class="power-role">{power.role}</span>
						</div>
						<div class="power-face power-back">
							<h4>{power.backTitle}</h4>
							<p>{power.backDesc}</p>
							<ul class="power-bullets">
								{power.bullets.map((bullet) => (
									<li>
										<bullet.icon size={14} class="power-bullet-icon" />
										<span>{bullet.text}</span>
									</li>
								))}
							</ul>
							<div class="power-stats">
								{power.stats.map((stat) => (
									<span class="power-stat">{stat}</span>
								))}
							</div>
						</div>
					</div>
				</button>
			))
		}
	</div>
</section>

<script>
	document.addEventListener('astro:page-load', () => {
		document.querySelectorAll<HTMLButtonElement>('.power-card').forEach((card) => {
			if (card.dataset.flipBound) return;
			card.dataset.flipBound = 'true';

			card.addEventListener('click', () => {
				const flipped = card.classList.toggle('is-flipped');
				card.setAttribute('aria-pressed', String(flipped));
			});
		});
	});
</script>

<style>
	.powers-grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.power-card {
		display: block;
		width: 100%;
		height: 500px;
		perspective: 1200px;
		background: none;
		border: none;
		padding: 0;
		margin: 0;
		font: inherit;
		text-align: inherit;
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		/* lets .power-back scale its type down as the card itself narrows
		   (4 columns sharing the grid means "desktop" still ranges from
		   ~300px cards down to ~140px) instead of overflowing its fixed
		   500px height — see the @container rules near .power-back below */
		container-type: inline-size;
	}

	.power-card-inner {
		position: relative;
		width: 100%;
		height: 100%;
		border-radius: 20px;
		transition: transform 0.5s cubic-bezier(0.4, 0.2, 0.2, 1), box-shadow 0.3s ease;
		transform-style: preserve-3d;
	}

	/* Hover only invites — a lift, nothing flips yet */
	.power-card:hover .power-card-inner {
		transform: translateY(-4px);
		box-shadow: 0 12px 32px rgba(0, 0, 0, 0.18);
	}

	/* An actual click/tap flips it */
	.power-card.is-flipped .power-card-inner {
		transform: rotateY(180deg);
	}

	.power-card.is-flipped:hover .power-card-inner {
		transform: rotateY(180deg) translateY(-4px);
	}

	/* sits in normal flow now, just above the role label at the bottom of
	   the card, instead of floating over the title up top */
	.power-hint {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.68rem;
		color: var(--accent);
		background: var(--accent-soft);
		padding: 5px 10px;
		border-radius: var(--radius-pill);
		margin-bottom: 10px;
		opacity: 0;
		transform: translateY(4px);
		transition: opacity 0.25s ease, transform 0.25s ease;
	}

	.power-card:hover .power-hint {
		opacity: 1;
		transform: translateY(0);
	}

	/* touch input has no hover, so the hint would otherwise never appear —
	   show it outright instead of gating it behind an interaction the
	   device can't perform */
	@media (hover: none) {
		.power-hint {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.power-card.is-flipped .power-hint {
		display: none;
	}

	.power-face {
		position: absolute;
		inset: 0;
		overflow: hidden;
		backface-visibility: hidden;
		border-radius: 20px;
		border: 1px solid var(--line);
		padding: 28px;
		box-sizing: border-box;
	}

	.power-front {
		background: var(--card);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		text-align: center;
		overflow: hidden;
	}

	.power-sparkle {
		position: absolute;
		color: var(--line);
	}

	.power-sparkle-a {
		top: 22px;
		right: 44px;
	}

	.power-sparkle-b {
		top: 96px;
		left: 28px;
	}

	.power-front h4 {
		font-family: var(--font-display);
		font-size: 1.3rem;
		font-weight: 800;
		color: var(--ink);
		letter-spacing: -0.01em;
		line-height: 1.15;
		max-width: 20ch;
	}

	.power-illustration {
		position: relative;
		flex: 1;
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 10px 0;
	}

	.power-illustration :global(.power-icon) {
		position: relative;
		width: 100%;
		max-width: 230px;
		padding: 0 16px;
	}

	.power-illustration :global(.power-icon svg) {
		display: block;
		width: 100%;
		height: auto;
	}

	.power-role {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.85rem;
		color: var(--ink-soft);
	}

	.power-back {
		background: var(--card-mid);
		transform: rotateY(180deg);
		display: flex;
		flex-direction: column;
	}

	.power-back h4 {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--ink);
		letter-spacing: -0.015em;
		line-height: 1.15;
		margin-bottom: 14px;
	}

	.power-back p {
		font-size: 1.02rem;
		line-height: 1.5;
		color: var(--ink-soft);
		margin-bottom: 16px;
	}

	.power-bullets {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 11px;
		margin-bottom: 16px;
	}

	.power-bullets li {
		display: flex;
		align-items: flex-start;
		gap: 9px;
		font-size: 0.86rem;
		line-height: 1.4;
		color: var(--ink-soft);
	}

	.power-bullet-icon {
		flex-shrink: 0;
		margin-top: 2px;
		color: var(--accent);
	}

	.power-stats {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 16px;
	}

	.power-stat {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.78rem;
		padding: 6px 12px;
		background: var(--accent-soft);
		color: var(--accent);
		border-radius: var(--radius-pill);
	}

	/* the 4 cards share one row, so a "desktop" card can be anywhere from
	   ~300px wide down to ~140px depending on how narrow the window gets
	   before the 640px breakpoint below hands off to a single column.
	   The longest back-face content (bullets + stats) started overflowing
	   its fixed 500px height as low as ~280px, silently clipped by
	   .power-face's overflow:hidden — these tiers scale the back-face
	   type down to match instead of losing content off the bottom. */
	@container (max-width: 280px) {
		.power-face { padding: 22px; }
		.power-back h4 { font-size: 1.2rem; margin-bottom: 10px; }
		.power-back p { font-size: 0.86rem; line-height: 1.4; margin-bottom: 10px; }
		.power-bullets { gap: 7px; margin-bottom: 10px; }
		.power-bullets li { font-size: 0.74rem; line-height: 1.3; }
		.power-stats { margin-top: 10px; gap: 6px; }
		.power-stat { font-size: 0.66rem; padding: 4px 9px; }
	}

	@container (max-width: 220px) {
		.power-face { padding: 18px; }
		.power-back h4 { font-size: 1.05rem; margin-bottom: 8px; }
		.power-back p { font-size: 0.76rem; margin-bottom: 8px; }
		.power-bullets { gap: 6px; margin-bottom: 8px; }
		.power-bullets li { font-size: 0.66rem; }
		.power-stat { font-size: 0.6rem; padding: 3px 8px; }
	}

	@container (max-width: 160px) {
		.power-face { padding: 14px; }
		.power-back h4 { font-size: 0.92rem; margin-bottom: 6px; }
		.power-back p { font-size: 0.68rem; line-height: 1.32; margin-bottom: 6px; }
		.power-bullets { gap: 5px; margin-bottom: 6px; }
		.power-bullets li { font-size: 0.6rem; line-height: 1.25; }
		.power-stat { font-size: 0.54rem; padding: 3px 7px; }
	}

	@media (max-width: 640px) {
		.powers-grid {
			grid-template-columns: 1fr;
		}

		.power-card {
			height: 390px;
		}
	}
</style>
