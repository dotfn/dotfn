---
import { FolderGit2, ExternalLink } from '@lucide/astro';
import { Image } from 'astro:assets';
import projects from '../../data/projects.json';
import bondimdpHome from '../../assets/bondi-mdp-home.png';
import bondimdpIcon from '../../assets/bondimdp-icono.jpg';
import brewmenuHome from '../../assets/brewmenu-home.png';
import lumusControlHome from '../../assets/lumus-control-home.png';

const COVER_IMAGE: Record<string, ImageMetadata> = {
	bondimdp: bondimdpHome,
	brewmenu: brewmenuHome,
	'lumus-control': lumusControlHome,
};

// devicon.dev doesn't cover generic concepts (PWA, geolocation, hardware) —
// those fall back to a plain color dot instead of a missing-icon glyph.
const DEVICON: Record<string, string> = {
	'React': 'react/react-original',
	'Next.js': 'nextjs/nextjs-original',
	'TypeScript': 'typescript/typescript-original',
	'Swift': 'swift/swift-original',
	'JavaScript': 'javascript/javascript-original',
	'Astro': 'astro/astro-original',
};
const DEVICON_BASE = 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons';

const TECH_DOT: Record<string, string> = {
	'PWA': '#3ee68f',
	'Geolocalización': '#b892f5',
	'Hardware': '#a3a3ab',
	'Tauri': '#ffc131',
};
---

<section class="home-section" id="proyectos">
	<h2 class="section-num">01 / Casos de Impacto</h2>
	<h3 class="section-heading">Productos en producción, con métricas reales</h3>

	<div class="projects-grid">
		{
			projects.map((project: any) => (
				<article class={`project-card card-glow ${project.big ? 'is-big' : ''}`}>
					{COVER_IMAGE[project.id] && (
						<div class="project-cover">
							<Image src={COVER_IMAGE[project.id]} alt={`Captura de ${project.name}`} width={1200} height={675} />
						</div>
					)}
					<div class="project-card-head">
						<div class="project-title-group">
							<span class="project-icon" aria-hidden="true">
								{project.id === 'bondimdp' ? (
									<Image src={bondimdpIcon} alt="" width={36} height={36} class="project-icon-img" />
								) : (
									<FolderGit2 size={18} />
								)}
							</span>
							<h4 class="project-name">{project.name}</h4>
						</div>
						<span class="project-badge">{project.badge}</span>
					</div>

					<div class="project-body">
						<p class="project-desc">{project.description}</p>

						{project.big && project.stats && (
							<div class="project-stats">
								{project.stats.map((stat: any) => (
									<div class="project-stat">
										<span class="stat-value">{stat.value}</span>
										<span class="stat-label">{stat.label}</span>
									</div>
								))}
							</div>
						)}
					</div>

					<div class="project-card-foot">
						<div class="project-tech">
							{project.tech.map((tech: string) =>
								DEVICON[tech] ? (
									<span class="tech-item">
										<span class="tech-icon-chip">
											<img src={`${DEVICON_BASE}/${DEVICON[tech]}.svg`} alt="" width="12" height="12" loading="lazy" />
										</span>
										{tech}
									</span>
								) : (
									<span class="tech-item">
										<i class="tech-dot" style={`background:${TECH_DOT[tech] ?? 'var(--accent)'}`} />
										{tech}
									</span>
								)
							)}
						</div>
						{project.url && (
							<a
								href={project.url}
								class="project-link"
								target={project.url.startsWith('/') ? '_self' : '_blank'}
								rel={project.url.startsWith('/') ? undefined : 'noopener noreferrer'}
							>
								{project.urlLabel}
								<ExternalLink size={13} class="link-icon-inline" />
							</a>
						)}
					</div>
				</article>
			))
		}
	</div>
</section>

<style>
	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 20px;
	}

	.project-card {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 20px;
		padding: 28px;
		display: flex;
		flex-direction: column;
		box-shadow: var(--shadow-btn);
		transition: var(--transition), var(--transition-theme);
	}

	.project-card:hover {
		border-color: var(--accent);
		transform: translateY(-3px);
		box-shadow: var(--shadow-deep);
	}

	.project-card.is-big {
		grid-column: 1 / -1;
		padding: 40px;
	}

	.project-card-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		margin-bottom: 16px;
	}

	.project-title-group {
		display: flex;
		align-items: center;
		gap: 14px;
		min-width: 0;
	}

	.project-icon {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: 10px;
		background: var(--card-mid);
		border: 1px solid var(--line);
		color: var(--accent);
		flex-shrink: 0;
		overflow: hidden;
	}

	.project-icon-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.project-cover {
		aspect-ratio: 2.2 / 1;
		margin-bottom: 24px;
		overflow: hidden;
		border-radius: 16px;
	}

	.is-big .project-cover {
		aspect-ratio: 2.6 / 1;
	}

	.project-cover :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	/* thin divider between the framed cover and the text below — only
	   appears on cards that actually have a cover image */
	.project-cover + .project-card-head {
		padding-top: 20px;
		border-top: 1px solid var(--line);
	}

	.project-badge {
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.7rem;
		font-weight: 600;
		padding: 4px 12px;
		background: var(--accent-soft);
		color: var(--accent);
		border-radius: var(--radius-pill);
	}

	.project-name {
		font-family: var(--font-display);
		font-size: 1.5rem;
		font-weight: 800;
		color: var(--ink);
		letter-spacing: -0.02em;
		min-width: 0;
	}

	.is-big .project-name {
		font-size: clamp(1.5rem, 2.4vw, 2rem);
	}

	.project-body {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 40px;
		flex-grow: 1;
		margin-bottom: 20px;
	}

	.project-desc {
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--ink-soft);
		flex: 1;
	}

	.is-big .project-desc {
		max-width: 56ch;
	}

	.project-stats {
		display: flex;
		gap: 32px;
		flex-wrap: wrap;
		flex-shrink: 0;
	}

	.project-stat {
		display: flex;
		flex-direction: column;
	}

	.stat-value {
		font-family: 'JetBrains Mono', monospace;
		font-size: 1.7rem;
		font-weight: 700;
		color: var(--accent);
		letter-spacing: -0.03em;
	}

	.stat-label {
		font-size: 0.78rem;
		color: var(--ink-soft);
		margin-top: 2px;
	}

	.project-card-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		padding-top: 20px;
		border-top: 1px solid var(--line);
	}

	.project-tech {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	.tech-item {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		font-size: 0.78rem;
		color: var(--ink-soft);
	}

	.tech-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		display: inline-block;
	}

	/* Fixed light backdrop so any devicon (some are dark/monochrome) stays
	   legible on both themes. */
	.tech-icon-chip {
		width: 16px;
		height: 16px;
		border-radius: 50%;
		background: #f2ede1;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.tech-icon-chip img {
		width: 12px;
		height: 12px;
		object-fit: contain;
	}

	.project-link {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-display);
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		text-decoration: none;
		transition: var(--transition);
	}

	.project-link:hover {
		transform: translateX(2px);
	}

	.link-icon-inline {
		margin-left: 4px;
	}

	@media (max-width: 860px) {
		.projects-grid {
			grid-template-columns: 1fr;
		}
		.project-card.is-big {
			padding: 28px;
		}
		.is-big .project-name {
			font-size: 1.4rem;
		}
		.project-body {
			flex-direction: column;
			gap: 20px;
		}
		.project-stats {
			gap: 28px;
		}
	}
</style>
