---
const DEVICON_BASE = 'https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons';
// devicon doesn't carry these AI-tool brand marks yet — simple-icons does.
const SIMPLEICONS_BASE = 'https://cdn.jsdelivr.net/npm/simple-icons@latest/icons';

interface Tech {
	name: string;
	slug: string;
	source?: 'simple';
}

const marqueeRow1: Tech[] = [
	{ name: 'React', slug: 'react/react-original' },
	{ name: 'Next.js', slug: 'nextjs/nextjs-original' },
	{ name: 'Astro', slug: 'astro/astro-original' },
	{ name: 'TypeScript', slug: 'typescript/typescript-original' },
	{ name: 'Tailwind CSS', slug: 'tailwindcss/tailwindcss-original' },
	{ name: 'Figma', slug: 'figma/figma-original' },
];

const marqueeRow2: Tech[] = [
	{ name: 'Python', slug: 'python/python-original' },
	{ name: 'JavaScript', slug: 'javascript/javascript-original' },
	{ name: 'Git', slug: 'git/git-original' },
	{ name: 'GitHub', slug: 'github/github-original' },
	{ name: 'Node.js', slug: 'nodejs/nodejs-original' },
];

const marqueeRow3: Tech[] = [
	{ name: 'VS Code', slug: 'vscode/vscode-original' },
	{ name: 'Claude', slug: 'claude', source: 'simple' },
	{ name: 'Cursor', slug: 'cursor', source: 'simple' },
	{ name: 'Gemini', slug: 'googlegemini', source: 'simple' },
	{ name: 'Supabase', slug: 'supabase/supabase-original' },
];

const marqueeRows = [marqueeRow1, marqueeRow2, marqueeRow3];
const iconSrc = (tech: Tech) => `${tech.source === 'simple' ? SIMPLEICONS_BASE : DEVICON_BASE}/${tech.slug}.svg`;
---

<section class="home-section focus-section" id="foco" data-no-reveal>
	<div class="focus-head">
		<h2 class="section-num">04 / Foco Actual</h2>
		<h3 class="section-heading">Human in the Loop</h3>
	</div>

	<div class="focus-bento">
		<div class="focus-card focus-text-card">
			<p class="focus-text">
				Los agentes de IA aceleran mi flujo de trabajo: prototipo ideas, automatizo tareas repetitivas y escribo código más rápido. Las decisiones importantes las sigo tomando yo: reviso cada output, cuestiono lo que proponen y decido qué llega a producción.
			</p>
		</div>

		<div class="focus-card focus-marquee-card">
			<div class="focus-marquee" aria-label={`Tecnologías: ${marqueeRows.flat().map(t => t.name).join(', ')}`}>
				{marqueeRows.map((row, rowIndex) => (
					<div class={`marquee-row ${rowIndex % 2 === 1 ? 'marquee-row-reverse' : ''}`}>
						<div class="marquee-track">
							{[...row, ...row].map((tech, i) => (
								<span class="marquee-item" aria-hidden={i >= row.length ? 'true' : undefined}>
									<img src={iconSrc(tech)} alt="" width="28" height="28" loading="lazy" />
									{tech.name}
								</span>
							))}
						</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>

<style>
	/* matches .focus-bento's own column math below, so the heading wraps
	   to the same width as the text card instead of running under the
	   marquee card too */
	.focus-head .section-heading {
		<!-- font-size: clamp(2.25rem, 4vw, 3rem); -->
		max-width: calc((100% - 20px) * 1.3 / 2.3);
	}

	.focus-bento {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 20px;
		align-items: stretch;
	}

	.focus-card {
		background: var(--card);
		border: 1px solid var(--line);
		border-radius: 20px;
		padding: 22px;
		box-shadow: var(--shadow-btn);
	}

	.focus-marquee-card {
		display: flex;
		align-items: center;
		overflow: hidden;
	}

	.focus-text-card {
		display: flex;
		align-items: center;
	}

	.focus-text {
		font-size: 0.95rem;
		line-height: 1.6;
		color: var(--ink-soft);
	}

	.focus-marquee {
		display: flex;
		flex-direction: column;
		gap: 12px;
		width: 100%;
	}

	.marquee-row {
		overflow: hidden;
		-webkit-mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
		mask-image: linear-gradient(to right, transparent, #000 8%, #000 92%, transparent);
	}

	.marquee-track {
		display: flex;
		width: max-content;
		gap: 12px;
		animation: marquee-scroll 28s linear infinite;
	}

	.marquee-row-reverse .marquee-track {
		animation-direction: reverse;
	}

	@keyframes marquee-scroll {
		from { transform: translateX(0); }
		to { transform: translateX(-50%); }
	}

	.marquee-item {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		flex-shrink: 0;
		font-family: 'JetBrains Mono', monospace;
		font-size: 0.82rem;
		color: var(--ink-soft);
		background: var(--card-mid);
		border: 1px solid var(--line);
		border-radius: 14px;
		padding: 10px 16px;
	}

	.marquee-item img {
		width: 28px;
		height: 28px;
		object-fit: contain;
		/* fixed light chip behind each logo — several devicons (Next.js,
		   GitHub) and simple-icons brand marks (Claude, Cursor, Gemini) are
		   solid dark shapes that vanish on the dark theme's own dark card
		   background */
		background: #f2ede1;
		border-radius: 8px;
		padding: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.marquee-track {
			animation: none;
		}
	}

	@media (max-width: 720px) {
		.focus-bento {
			grid-template-columns: 1fr;
		}

		.focus-head .section-heading {
			max-width: none;
		}
	}

	@media (max-width: 640px) {
		.focus-card {
			padding: 22px;
		}
	}
</style>
