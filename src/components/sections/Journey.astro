---
import { Terminal, Video, LayoutTemplate as LayoutIcon, GraduationCap } from '@lucide/astro';
import { Image } from 'astro:assets';
import FdaLogo from '../icons/FdaLogo.astro';
import UtnLogo from '../icons/UtnLogo.astro';
import facultadInformaticaLogo from '../../assets/logo-facultada-de-informatica.svg';
---

<section class="home-section journey-section" id="journey" data-no-reveal>
	<div class="journey-sticky-label">
		<h2 class="section-num">05 / Trayectoria</h2>
	</div>
	<div class="journey-body">
		<h3 class="section-heading">Un criterio de producto construido desde distintas disciplinas</h3>
		<p class="journey-intro">
			Pasé por la informática, el arte y el diseño antes de dedicarme al desarrollo de software — esa mezcla es la que hoy me permite pensar tu producto de punta a punta: negocio, experiencia y código, no solo una parte.
		</p>
		<div class="journey-timeline" id="journeyTimeline">
			<div class="journey-item" data-index="0" data-logo="informatica">
				<span class="journey-year">2018</span>
				<div class="journey-content">
					<h4>
						<Terminal size={19} class="timeline-icon" />
						Licenciatura en Informática (UNLP - FI)
					</h4>
					<p>Mi primer acercamiento a la programación y al pensamiento lógico. Descubrí cómo descomponer problemas y construir soluciones paso a paso.</p>
				</div>
			</div>
			<div class="journey-item" data-index="1" data-logo="artes-audiovisuales">
				<span class="journey-year">2018</span>
				<div class="journey-content">
					<h4>
						<Video size={19} class="timeline-icon" />
						Artes Audiovisuales (UNLP - FDA)
					</h4>
					<p>Exploré la narrativa, el lenguaje visual y la comunicación. Aprendí que toda experiencia transmite un mensaje, incluso cuando el expectador no lo percibe de forma consciente.</p>
				</div>
			</div>
			<div class="journey-item" data-index="2" data-logo="diseno-multimedial">
				<span class="journey-year">2019 - 2022</span>
				<div class="journey-content">
					<h4>
						<LayoutIcon size={19} class="timeline-icon" />
						Licenciatura en Diseño Multimedial (UNLP - FDA)
					</h4>
					<p>Profundicé en diseño de interfaces, experiencia de usuario, prototipado y desarrollo interactivo. Fue la etapa donde entendí que el diseño y la tecnología no compiten: trabajan mejor cuando forman parte del mismo proceso.</p>
				</div>
			</div>
			<div class="journey-item" data-index="3" data-logo="utn">
				<span class="journey-year">2025 - Pres.</span>
				<div class="journey-content">
					<h4>
						<GraduationCap size={21} class="timeline-icon" />
						Tecnicatura en Programación UTN - MDP
					</h4>
					<p>Consolidé mis fundamentos en desarrollo de software.</p>
				</div>
			</div>
		</div>
	</div>

	<div class="journey-logo-stage" aria-hidden="true">
		<Image src={facultadInformaticaLogo} alt="Facultad de Informática — UNLP" width={220} height={220} class="journey-logo-img" data-logo-key="informatica" />
		<FdaLogo accent="#c62828" accentDot="row2-1" class="journey-logo-img journey-logo-svg" data-logo-key="artes-audiovisuales" />
		<FdaLogo accent="#8e3aad" accentDot="row2-3" class="journey-logo-img journey-logo-svg" data-logo-key="diseno-multimedial" />
		<UtnLogo class="journey-logo-img journey-logo-svg" data-logo-key="utn" />
	</div>
</section>

<style>
	/* layout */
	.journey-section {
		/* .journey-body's own padding-bottom (the sticky logo stage's
		   runway) already provides the trailing gap before the next section */
		margin-bottom: 0;
		margin-top: 240px;
		display: grid;
		grid-template-columns: 180px minmax(380px, 1fr) minmax(260px, 340px);
		gap: 0 40px;
		align-items: start;
	}

	/* STICKY LABEL (left column) */
	.journey-sticky-label {
		grid-column: 1;
		position: sticky;
		top: 340px;
		align-self: start;
		padding-top: 6px;
	}

	/* This column's label sits beside the timeline rather than above it */
	.journey-sticky-label .section-num {
		margin-bottom: 0;
	}

	.journey-intro {
		font-size: 1rem;
		line-height: 1.65;
		color: var(--ink-soft);
		max-width: 62ch;
		margin-bottom: 40px;
	}

	/* extra runway at the bottom of this grid row so the sticky logo stage
	   (third column) has room to fully settle at `top` even while the last
	   timeline item is active — without it, the row (sized to this
	   column's content) ends too soon and drags the stage up mid-
	   transition, clipping it against the viewport top. */
	.journey-body {
		/* explicit placement — otherwise, once the script pulls the label
		   and logo stage out of grid flow (position: absolute) below,
		   auto-placement drops this into column 1 (the label's narrow
		   180px track) instead of column 2, exploding text wrap height */
		grid-column: 2;
		padding-bottom: 240px;
	}

	.journey-timeline {
		position: relative;
		padding-left: 20px;
		border-left: 2px solid var(--line);
		transition: var(--transition-theme);
	}

	/* third grid column, sibling to .journey-sticky-label and .journey-body
	   — same "grid child" setup that already lets the sticky label track
	   scroll correctly, so this sticks the same way instead of fighting a
	   nested flex row's shorter containing block. Crossfades to whichever
	   item's date is currently level with the sticky "05 / Trayectoria"
	   label (see the script below). */
	.journey-logo-stage {
		grid-column: 3;
		position: sticky;
		top: 300px;
		align-self: start;
		min-height: 260px;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* :global() — the FDA logo is an inline <svg> rendered by a child
	   component (FdaLogo.astro), so Astro's scoped data-attribute never
	   reaches it; matching by plain class name is the only way these
	   rules apply to it too. */
	:global(.journey-logo-img) {
		position: absolute;
		width: 220px;
		height: 220px;
		object-fit: contain;
		background: #f2ede1;
		border-radius: 50%;
		padding: 26px;
		border: 1px solid var(--line);
		box-shadow: var(--shadow-deep);
		opacity: 0;
		transform: scale(0.9);
		transition: opacity 0.5s cubic-bezier(0.16,1,0.3,1), transform 0.5s cubic-bezier(0.16,1,0.3,1);
	}

	/* :global() so the JS-added class bypasses Astro scope hashing */
	:global(.journey-logo-img.is-active) {
		opacity: 1;
		transform: scale(1);
	}

	/* below this, the fixed-width columns (label + logo stage) don't leave
	   the content column enough room to read comfortably — drop the logo
	   stage entirely rather than let it squeeze the timeline text */
	@media (max-width: 1300px) {
		.journey-section {
			grid-template-columns: 180px 1fr;
		}

		.journey-logo-stage {
			display: none;
		}
	}

	/* each timeline item hidden until scroll-reveals */
	.journey-item {
		position: relative;
		margin-bottom: 120px;
		display: grid;
		grid-template-columns: 80px 1fr;
		gap: 20px;
		opacity: 0;
		transform: translateX(-12px);
		transition: opacity 0.55s cubic-bezier(0.16,1,0.3,1), transform 0.55s cubic-bezier(0.16,1,0.3,1);
	}

	/* :global() so the JS-added class bypasses Astro scope hashing */
	:global(.journey-item.journey-in) {
		opacity: 1;
		transform: translateX(0);
	}

	.journey-item:last-child {
		margin-bottom: 0;
	}

	.journey-year {
		font-family: 'JetBrains Mono', monospace;
		font-size: 1rem;
		font-weight: 600;
		color: var(--accent);
		line-height: 1.4;
		transition: color 0.3s;
	}

	/* timeline dot — base */
	.journey-item::before {
		content: '';
		position: absolute;
		left: -27px;
		top: 5px;
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: var(--bg);
		border: 2px solid var(--line);
		transition: border-color 0.4s ease, background 0.4s ease, box-shadow 0.4s ease, transform 0.4s ease;
	}

	/* :global() so JS-added class is matched after Astro scoping */
	:global(.journey-item.journey-in)::before {
		border-color: var(--accent);
		background: var(--accent-soft);
		box-shadow: 0 0 0 4px var(--accent-soft);
		transform: scale(1.2);
	}

	.journey-content h4 {
		font-family: var(--font-display);
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--ink);
		margin-bottom: 10px;
		transition: color 0.3s;
	}

	.journey-item.journey-in .journey-content h4 {
		color: var(--ink);
	}

	.journey-content p {
		font-size: 1.02rem;
		line-height: 1.65;
		color: var(--ink-soft);
		max-width: 55ch;
	}

	.timeline-icon {
		margin-right: 8px;
		vertical-align: text-bottom;
		display: inline-block;
		color: var(--accent);
		transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
	}

	/* icon pop via :global so JS class is recognized */
	:global(.journey-item.journey-in) .timeline-icon {
		transform: scale(1.15);
	}

	/* mobile: collapse 2-column sticky layout */
	@media (max-width: 768px) {
		.journey-section {
			grid-template-columns: 1fr;
		}

		.journey-sticky-label,
		.journey-body {
			grid-column: 1;
		}

		.journey-sticky-label {
			position: static;
			margin-bottom: 12px;
		}
	}

	@media (max-width: 480px) {
		.journey-item {
			grid-template-columns: 1fr;
			gap: 4px;
		}

		.journey-item::before {
			left: -25px;
		}
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		// Staggered IntersectionObserver for timeline items
		const items = document.querySelectorAll('#journeyTimeline .journey-item');
		if (items.length) {
			const io = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						const idx = Number((entry.target as HTMLElement).dataset.index) || 0;
						setTimeout(() => {
							entry.target.classList.add('journey-in');
						}, idx * 140);
						io.unobserve(entry.target);
					}
				});
			}, { threshold: 0.2, rootMargin: '0px 0px -40px 0px' });
			items.forEach(el => io.observe(el));
		}

		// Crossfades the institute logo in the free space next to the
		// timeline: whichever item's date row is the last one to have
		// crossed the sticky "05 / Trayectoria" label's line becomes the
		// active one. Driven directly off scroll position (rAF-throttled)
		// rather than IntersectionObserver — items sit closer together
		// than a reveal-style trigger band, so multiple would overlap the
		// band at once and fire in DOM order instead of "closest to the
		// label". Any item without a data-logo would be skipped (last
		// matched logo just stays put instead of disappearing) —
		// currently every item has one.
		//
		// The last item still needs .journey-body's padding-bottom runway
		// to reach its fully-settled `top` once — but past that, CSS
		// sticky has nothing left to pin against (the row ends shortly
		// after) and starts unsticking on its own. Label and stage have
		// different top/height combos, so left to native sticky they'd
		// unstick at different scroll amounts and visibly drift apart —
		// the label left behind while the item itself keeps scrolling up
		// past it. A one-time "freeze the current position" approach was
		// tried here and discarded: it depends on a `current === lastItem`
		// boolean staying perfectly in sync with real (Lenis-smoothed)
		// scroll events, and any single frame where that flips — a wheel
		// flick overshooting, a resize, a rAF skipped under load — desyncs
		// the two permanently until the user scrolls back out and in again.
		// Instead, every frame both elements' `top` is recomputed fresh
		// from the *live* gap between the last item and the trigger line:
		// zero once the item hasn't reached it yet (native sticky, as
		// before), then that same negative delta subtracted from both
		// elements' base `top` once it has. Pure function of current
		// scroll position — nothing to fall out of sync because there's
		// no state carried between frames.
		const logoImgs = document.querySelectorAll<HTMLElement>('.journey-logo-img');
		const loggedItems = document.querySelectorAll<HTMLElement>('#journeyTimeline .journey-item[data-logo]');
		const stickyLabel = document.querySelector<HTMLElement>('.journey-sticky-label');
		const logoStage = document.querySelector<HTMLElement>('.journey-logo-stage');
		if (logoImgs.length && loggedItems.length && stickyLabel && logoStage) {
			const LABEL_TOP = parseFloat(getComputedStyle(stickyLabel).top) || 0;
			const STAGE_TOP = parseFloat(getComputedStyle(logoStage).top) || 0;
			const lastItem = loggedItems[loggedItems.length - 1];
			let ticking = false;
			let lastKey = '';

			const updateActiveLogo = () => {
				ticking = false;

				let current: HTMLElement | null = null;
				loggedItems.forEach((el) => {
					if (el.getBoundingClientRect().top <= LABEL_TOP) current = el;
				});
				const key = current ? (current as HTMLElement).dataset.logo ?? '' : '';
				if (key && key !== lastKey) {
					lastKey = key;
					logoImgs.forEach((img) => {
						img.classList.toggle('is-active', img.dataset.logoKey === key);
					});
				}

				const overshoot = Math.min(0, lastItem.getBoundingClientRect().top - LABEL_TOP);
				stickyLabel.style.top = `${LABEL_TOP + overshoot}px`;
				logoStage.style.top = `${STAGE_TOP + overshoot}px`;
			};

			const onScroll = () => {
				if (ticking) return;
				ticking = true;
				requestAnimationFrame(updateActiveLogo);
			};

			window.addEventListener('scroll', onScroll, { passive: true });
			updateActiveLogo();
		}
	});
</script>
