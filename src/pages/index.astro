---
import { Sun, Moon } from '@lucide/astro';
import Layout from '../layouts/Layout.astro';
import profileData from '../data/profile.json';
import ProfileCard from '../components/ProfileCard.astro';
import Hero from '../components/sections/Hero.astro';
import Focus from '../components/sections/Focus.astro';
import Projects from '../components/sections/Projects.astro';
import GitHubActivity from '../components/sections/GitHubActivity.astro';
import Journey from '../components/sections/Journey.astro';
import CurrentFocus from '../components/sections/CurrentFocus.astro';
import Contact from '../components/sections/Contact.astro';
import Footer from '../components/Footer.astro';

const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"name": "Nicolás Jiménez",
	"alternateName": "dotfn",
	"url": "https://dotfn.dev",
	"image": "https://dotfn.dev/contact-profile.jpg",
	"sameAs": [
		"https://github.com/dotfn",
		"https://www.linkedin.com/in/dotfn"
	],
	"jobTitle": "Forward Deployed Engineer & AI Developer",
	"description": "Software Developer argentino con background en Diseño Multimedia y UX/UI, cocreador de BondiMDP (PWA de transporte usada por miles de personas en Mar del Plata) y autor de herramientas propias como lumus-control y brewmenu. Combina diseño, producto y desarrollo full stack."
};

const bondiMDPSchema = {
	"@context": "https://schema.org",
	"@type": "SoftwareApplication",
	"name": "BondiMDP",
	"url": "https://bondimdp.com.ar",
	"applicationCategory": "TravelApplication",
	"operatingSystem": "All",
	"description": "Plataforma digital para mejorar la experiencia del transporte público en Mar del Plata mediante información de arribos en tiempo real."
};

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	"mainEntity": [
		{
			"@type": "Question",
			"name": "¿Quién es Nicolás Jiménez (dotfn)?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Nicolás Jiménez (también conocido como dotfn) es un Software Developer argentino con formación en diseño multimedial de la UNLP y programación en la UTN. Se especializa en la intersección de diseño de producto UX/UI, desarrollo full stack y herramientas de IA."
			}
		},
		{
			"@type": "Question",
			"name": "¿Qué proyectos destacados ha creado dotfn?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Su proyecto más destacado es BondiMDP, una aplicación colaborativa PWA de transporte público en Mar del Plata que superó los 19,000 usuarios en su primer mes, desarrollada con React, Next.js y geolocalización en tiempo real."
			}
		},
		{
			"@type": "Question",
			"name": "¿Cuáles son las habilidades técnicas de Nicolás Jiménez?",
			"acceptedAnswer": {
				"@type": "Answer",
				"text": "Sus habilidades técnicas principales incluyen React, Next.js, JavaScript, Astro, HTML, CSS/Tailwind CSS, Git/GitHub y diseño con Figma, con experiencia en el desarrollo de Progressive Web Apps (PWA) e integración de APIs."
			}
		}
	]
};

const schemas = [personSchema, bondiMDPSchema, faqSchema];
---

<Layout
	title={`${profileData.name} · Portfolio & Digital Products`}
	description="Sitio personal de Nicolás Jiménez (dotfn). Software Developer & AI Developer, cocreador de BondiMDP y autor de herramientas como lumus-control y brewmenu."
	schema={schemas}
>
	<button type="button" class="theme-toggle" id="themeToggleNav" aria-label="Cambiar tema" title="Cambiar tema">
		<Sun class="icon-sun" size={16} />
		<Moon class="icon-moon" size={16} />
	</button>

	<main>
		<Hero />

		<div class="home-wrapper">
			<Projects />
			<Focus />

			<div class="home-grid">
				<aside class="home-sidebar">
					<ProfileCard data={profileData} />
				</aside>

				<div class="home-content">
					<GitHubActivity />
					<CurrentFocus />
				</div>
			</div>

			<Journey />
		</div>

		<Contact />
	</main>

	<Footer />
</Layout>

<style>
	.home-wrapper {
		max-width: 1600px;
		margin: 0 auto;
		padding: 0 clamp(16px, 4vw, 64px);
	}

	.home-grid {
		display: grid;
		grid-template-columns: 340px 1fr;
		gap: 56px;
		align-items: start;
	}

	.home-sidebar,
	.home-content {
		min-width: 0;
	}

	/* tighter rhythm than the sitewide .home-section gap — keeps the
	   sidebar and this column's cards landing within one screen together */
	.home-content > :global(.home-section) {
		margin-bottom: 56px;
	}

	@media (max-width: 960px) {
		.home-grid {
			grid-template-columns: 1fr;
		}

		.home-sidebar {
			max-width: 420px;
			margin: 0 auto;
		}
	}

	@media (max-width: 480px) {
		.home-wrapper {
			padding: 0 16px;
		}
	}
</style>
